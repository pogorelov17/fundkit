# Copy to .env (git-ignored) or store these in Doppler and run: doppler run -- node src/cli.js ...
# Bybit API key for YOUR OWN account. Permissions: Assets/Wallet -> Account Transfer only
# (deposit records/addresses are readable with it). Do NOT enable Withdraw. Restrict to your IP.
BYBIT_API_KEY=
BYBIT_API_SECRET=
# https://api.bybit.com (default) | https://api.bytick.com | regional host (e.g. https://api.bybit.eu)
BYBIT_BASE_URL=https://api.bybit.com

# One or more independent BSC JSON-RPC endpoints (comma separated). All must agree on verification.
BSC_RPC_URLS=https://bsc-dataseed.bnbchain.org,https://bsc-rpc.publicnode.com

# Public HTTPS origin that forwards to HOST:PORT below (tunnel / reverse proxy / `host 8787`).
PUBLIC_BASE_URL=https://your-tunnel.example
HOST=127.0.0.1
PORT=8787

# Optional
# FUNDKIT_POLL_MS=5000
# FUNDKIT_TIMEOUT_MS=1800000

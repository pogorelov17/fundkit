# Copy to .env (git-ignored) or store these in Doppler and run: doppler run -- node src/cli.js ...
# Bybit API key for YOUR OWN main account, IP-restricted, never with Withdraw.
#   --target UNIFIED: read-write, only "Assets -> Wallet -> Account Transfer"; account must be Unified Trading.
#   --target FUND:    read-only, no permissions ticked.
BYBIT_API_KEY=
BYBIT_API_SECRET=
# Official mainnet hosts only: https://api.bybit.com (default) | https://api.bytick.com | regional
# (https://api.bybit.tr, .kz, .ae, .eu, .id, https://api.bybitgeorgia.ge, https://api.manepa.jp, https://api.spark-fintech.com)
BYBIT_BASE_URL=https://api.bybit.com

# Two or more independent BSC JSON-RPC endpoints (https, distinct hosts, comma separated).
# All must answer and agree on finalized evidence before anything is concluded.
BSC_RPC_URLS=https://bsc-dataseed.bnbchain.org,https://bsc-rpc.publicnode.com

# Public HTTPS URL (optionally with a path prefix) that forwards to HOST:PORT below.
PUBLIC_BASE_URL=https://your-tunnel.example
HOST=127.0.0.1
PORT=8787

# Optional
# FUNDKIT_STATE_KEY=   # >= 32 random chars; keeps chat state lines valid across API key rotation
# FUNDKIT_POLL_MS=5000
# FUNDKIT_TIMEOUT_MS=1800000
